{
  "info": {
    "_postman_id": "74b710c0-6188-4e4f-9f34-955d83b728cc",
    "name": "Warehouse Master API",
    "description": "Autentica con Login para guardar el JWT automáticamente. Las solicitudes protegidas heredan el Bearer Token de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "email",
      "value": "operador.demo@warehouse.local",
      "type": "string"
    },
    {
      "key": "password",
      "value": "WarehouseDemo123",
      "type": "string"
    },
    {
      "key": "jwt",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login (guardar JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "pm.test('Login exitoso y JWT recibido', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  pm.expect(payload.token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (pm.response.code === 200 && payload.token) {",
                  "  pm.collectionVariables.set('jwt', payload.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Usuario autenticado (probar JWT)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
